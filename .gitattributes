# Normalize line endings
* text=auto eol=lf

# Solidity
*.sol text eol=lf

# TypeScript / JavaScript
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf

# Config
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Docs
*.md text eol=lf

# Binaries (never touch)
*.png binary
*.jpg binary
*.pdf binary
*.woff2 binary
