# Server-only: target for lib/api/server-client.ts and the Bearer-injecting
# proxy (app/api/backend/[...path]/route.ts). Never exposed to the browser.
API_BASE_URL="http://localhost:3000"

# Public: direct client-side calls for the no-auth /verify/[id] page only.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# httpOnly session cookie name (server-only, set by app/api/auth/login/route.ts).
SESSION_COOKIE_NAME="trustai_session"

# Mirrors apps/api's PUBLIC_VERIFICATION_ENABLED flag — hides the /verify
# nav entry and renders "no disponible" instead of a failed fetch when the
# backend module isn't mounted.
NEXT_PUBLIC_PUBLIC_VERIFICATION_ENABLED="false"

# Builds anchor.txHash explorer links in the wizard/detail view. Defaults to
# Base Sepolia's explorer — change for a different chain/network.
NEXT_PUBLIC_CHAIN_EXPLORER_BASE_URL="https://sepolia.basescan.org"
