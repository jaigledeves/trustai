DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustai_dev"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000

# Asset storage (S3-compatible; MinIO locally via infrastructure/docker-compose.yml)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="trustai-assets-dev"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Async job queue (pg-boss, runs on the same PostgreSQL instance)
PGBOSS_SCHEMA="pgboss"

# App-layer AES-256-GCM encryption key for asset bytes (INV-12) — 32 raw
# bytes, base64-encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ASSET_ENCRYPTION_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

# AI document analysis adapter: "stub" (deterministic, no API key needed —
# default) or "openai" (real calls, requires OPENAI_API_KEY below).
AI_ADAPTER="stub"
# Required only when AI_ADAPTER="openai".
OPENAI_API_KEY=""
# Optional — defaults to gpt-5.4-mini if unset.
OPENAI_MODEL="gpt-5.4-mini"

# Blockchain anchoring (AnchorRegistry on Base Sepolia — see
# smart-contracts/README.md "Deploy (Base Sepolia)" for the full deploy
# procedure). All three are unset by default: ANCHOR_PORT then falls back
# to ChainNotConfiguredAnchorAdapter — the app boots normally and every
# other feature works; only an actual anchor submission attempt fails,
# with a clear error, until these are configured.
#
# TODO: after running `forge script script/Deploy.s.sol --broadcast --verify`
# (smart-contracts/), paste the deployed address here.
ANCHOR_CONTRACT_ADDRESS=""
# Same value as smart-contracts/.env's BASE_SEPOLIA_RPC_URL in production;
# point at a local anvil node (http://127.0.0.1:8545) for local dev/testing.

# 84532 = Base Sepolia. 31337 = local anvil (viem's "foundry" chain id).
CHAIN_ID="84532"
# The wallet that submits anchor() transactions — can be the same funded
# wallet used to deploy the contract, or a separate one (anchor() is
# permissionless). 0x-prefixed private key.
WORKER_WALLET_PRIVATE_KEY=""

# confirm-anchor job's self-requeue poll interval (INV-32: waits for 2
# confirmations before CERTIFIED). Design guess: real Base Sepolia block
# time is ~2s, so 15s comfortably covers 2 blocks without hammering the
# RPC. Lower this (e.g. "1") only for fast local anvil-backed testing.
CONFIRM_ANCHOR_POLL_INTERVAL_SECONDS="15"
# How long confirm-anchor keeps polling before giving up and triggering
# the automatic FAILED->ANCHORING retry (RF-033).
CONFIRM_ANCHOR_TIMEOUT_SECONDS="600"

# Public verification (UC-02, no-auth GET/POST /public/verify/:id). Unset
# (or any value other than "true") keeps the module out of AppModule's
# imports entirely — rollback plan: this flag is read at module-eval time
# (app.module.ts), before Nest's DI container exists, so it must be set as
# a real process env var (or in this .env file) before the API process
# starts — changing it requires a restart, not just a config reload.
PUBLIC_VERIFICATION_ENABLED="false"
# Rate limits for the public verification endpoints (RF-042's throttling
# requirement) — 60/min GET, 20/min POST are the spec defaults; only
# override for load testing or a stricter anti-abuse posture. Unaffected
# by the global rate limiting below (ADR-012 — explicitly exempted).
PUBLIC_VERIFY_GET_THROTTLE_LIMIT="60"
PUBLIC_VERIFY_POST_THROTTLE_LIMIT="20"

# Global rate limiting (ADR-012, api-rate-limiting spec) — the app-wide
# APP_GUARD's default window/count, keyed by authenticated user (JWT `sub`)
# or client IP for anonymous requests. Covers every route with no explicit
# per-route override.
THROTTLE_TTL_SECONDS="60"
THROTTLE_LIMIT="100"
# POST /assets (enqueues analyze-document against the paid OpenAI adapter)
# — deliberately stricter than THROTTLE_LIMIT.
UPLOAD_THROTTLE_LIMIT="5"
# POST /trust-records/:id/anchor (incurs on-chain gas cost).
ANCHOR_THROTTLE_LIMIT="10"
# Block explorer base URL used to build chainAnchor.explorerUrl
# (`${base}/tx/${txHash}`) in public verification responses. Defaults to
# Base Sepolia's explorer — change for a different chain/network.
CHAIN_EXPLORER_BASE_URL="https://sepolia.basescan.org"
