    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@prisma/client": "^6.0.0",
    "@trustai/dtr-core": "workspace:*",
    "argon2": "^0.41.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg-boss": "^12.25.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "unpdf": "^1.6.2",
    "uuid": "^11.0.0",
    "zod": "^3.25.76"
